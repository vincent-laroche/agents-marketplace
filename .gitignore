# Never commit a real MCP server config -- these carry bearer tokens.
# Commit a .mcp.example.json using ${ENV_VAR} placeholders instead.
# Broad by design: a narrow path rule silently stopped protecting anything when
# mcpmarket-me was moved from plugins/ to vendor/ on 2026-08-08.
**/.mcp.json
!**/.mcp.example.json
# Exception: this one carries no credentials -- it only spawns
# `npx -y chrome-devtools-mcp@<ver>` over stdio. Tracked intentionally.
!vendor/chrome-devtools-mcp/.mcp.json
# Python bytecode
__pycache__/
*.pyc

# macOS / Windows
.DS_Store*
Thumbs.db

# Node (in case a plugin adds tooling)
node_modules/
.backups/
